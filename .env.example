# ============================================
# AWS Rekognition POC - Configuração
# ============================================

# Credenciais AWS (com permissões mínimas para Rekognition)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1

# Nome da coleção de faces no Rekognition
COLLECTION_ID=poc-asseco-faces

# Thresholds padrão (podem ser ajustados na interface)
SIMILARITY_THRESHOLD=80.0
ANTISPOOFING_THRESHOLD=50.0
